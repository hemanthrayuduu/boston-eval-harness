.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
uv.lock

data/raw/
data/*.duckdb
runs/
.env

# Scraped source PDFs: re-fetchable, and verifiable against the hashes in posts.jsonl.
claims/sources/*/pdf/
# Extracted figures: 60+ MB, regenerated from the PDFs by claims.bpd_extract.
claims/sources/*/figures.jsonl
# Every candidate claim (~30k), regenerated by claims.bpd_claims; the corpus is the selection.
claims/candidates/
# Per-figure audit rows (~30k), regenerated by experiments.reproducibility_audit.
experiments/results/*/rows.jsonl
